# Copy to .env.local for local development. Never commit real values.

# Supabase (public; safe for the browser). Not available yet: see BRIEF.md Open questions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server only; bypasses row-level security). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles (OpenStreetMap-compatible). Defaults to the public OSM tile server for development only;
# set a policy-compliant provider URL before production. Use {z}/{x}/{y} placeholders.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
